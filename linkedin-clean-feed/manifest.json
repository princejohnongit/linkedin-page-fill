{
  "manifest_version": 3,
  "name": "LinkedIn Clean Feed",
  "version": "1.1.4",
  "description": "Transforms LinkedIn's desktop feed into a cleaner, wider two-column masonry layout.",
  "permissions": [],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "masonry.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}